<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.cakepedia.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_favorite"
        android:name="com.example.cakepedia.ui.favorite.FavoriteFragment"
        android:label="@string/title_favorite"
        tools:layout="@layout/fragment_favorite" >
        <action
            android:id="@+id/action_navigation_favorite_to_navigation_search2"
            app:destination="@id/navigation_search" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.cakepedia.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_search"
        android:name="com.example.cakepedia.ui.search.searchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search" >>

        <action
            android:id="@+id/action_navigation_search_to_navigation_kuecoklat"
            app:destination="@id/navigation_kuecoklat" />
        <action
            android:id="@+id/action_navigation_search_to_navigation_kuelebaran"
            app:destination="@id/navigation_kuelebaran" />
        <action
            android:id="@+id/action_navigation_search_to_navigation_kuemodern"
            app:destination="@id/navigation_kuemodern" />
        <action
            android:id="@+id/action_navigation_search_to_navigation_kuebasah"
            app:destination="@id/navigation_kuebasah" />
        <action
            android:id="@+id/action_navigation_search_to_navigation_kuetradisional"
            app:destination="@id/navigation_kuetradisional" />
        <action
            android:id="@+id/action_navigation_search_to_navigation_kuekukus"
            app:destination="@id/navigation_kuekukus" />

    </fragment>

    <fragment
        android:id="@+id/navigation_kuecoklat"
        android:name="com.example.cakepedia.ui.kategori.kuecoklatFragment"
        tools:layout="@layout/fragment_kuecoklat" />

    <fragment
        android:id="@+id/navigation_kuebasah"
        android:name="com.example.cakepedia.ui.kategori.KuebasahFragment"
        tools:layout="@layout/fragment_kuebasah" />

    <fragment
        android:id="@+id/navigation_kuemodern"
        android:name="com.example.cakepedia.ui.kategori.KuemodernFragment"
        tools:layout="@layout/fragment_kuemodern" />

    <fragment
        android:id="@+id/navigation_kuekukus"
        android:name="com.example.cakepedia.ui.kategori.KuekukusFragment"
        tools:layout="@layout/fragment_kuekukus" />

    <fragment
        android:id="@+id/navigation_kuelebaran"
        android:name="com.example.cakepedia.ui.kategori.KuelebaranFragment"
        tools:layout="@layout/fragment_kuelebaran" />

    <fragment
        android:id="@+id/navigation_kuetradisional"
        android:name="com.example.cakepedia.ui.kategori.KuetradisionalFragment"
        tools:layout="@layout/fragment_kuetradisional" />

</navigation>