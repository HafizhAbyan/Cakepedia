<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FFE9F0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Foto Profil -->
        <ImageView
            android:id="@+id/img_profile"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            android:layout_marginBottom="8dp"
            android:background="@drawable/profile_circle_bg" />

        <TextView
            android:text="Ubah Foto Profile"
            android:textSize="14sp"
            android:textColor="#000"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Nama Lengkap -->
        <TextView
            android:text="Nama Lengkap"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/et_name"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_profile"
            android:padding="12dp"
            android:text="Jessy Areum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Email -->
        <TextView
            android:text="Email"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/et_email"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_profile"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:text="jessya@gmail.com"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Nomor HP -->
        <TextView
            android:text="Nomor HP"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/et_phone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_profile"
            android:padding="12dp"
            android:inputType="phone"
            android:text="0812-3456-7890"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btn_save"
            android:text="Simpan Perubahan"
            android:backgroundTint="#A67C52"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Teks Kelola Akun & Logout -->
        <TextView
            android:id="@+id/tv_manage_account"
            android:text="Kelola Akun"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_logout"
            android:text="Keluar / Logout"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
